<!-- Enlace al manifiesto -->
<link rel="manifest" href="./manifest.json">

<!-- Colores de la interfaz del navegador (Coincidentes con el JSON) -->
<meta name="theme-color" content="#8B5A2B">
<meta name="background-color" content="#FFFAF3">

<!-- Soporte para iOS / Safari -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="MiPan">
<link rel="apple-touch-icon" href="assets/images/icon-192.png">

<!-- Favicons para navegador -->
<link rel="icon" type="image/png" sizes="192x192" href="assets/images/icon-192.png">
<link rel="icon" type="image/svg+xml" href="assets/images/logo.svg">
